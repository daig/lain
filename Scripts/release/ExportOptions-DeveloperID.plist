<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Scripts/release-mac-host.sh: export LainHost signed with Developer ID, for distribution outside the
     Mac App Store. Automatic signing creates the Developer ID provisioning profile that the data-protection
     Keychain entitlement (keychain-access-groups) needs. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>8DWR7MSCR6</string>
</dict>
</plist>
